# Copy to .env. Never commit .env, real tokens, or credentials.
# Required ONLY for live SEC lookups. Use your own real contact email.
SEC_USER_AGENT=ScaraScopeAI YourName your-email@example.com

# Optional. Without this, explanations are rule-based; no AI key is needed for demo.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional Ollama running on your laptop. Configure local network access separately.
# Never expose the Ollama API directly to the public Internet.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ENABLED=false

# Optional API authentication for research, agent, reports, watchlist, benchmarks and diagnostics.
# Mandatory before exposing the service to anyone beyond localhost.
SCARASCOPE_API_KEY=

# Optional settings. Timeouts are adjustable for slower hardware.
LOCAL_TIMEOUT_SECONDS=25
CLOUD_TIMEOUT_SECONDS=35
HISTORY_DB_PATH=./data/history.sqlite3

# Strictly require an API key before live public deployment. If true with a missing
# SCARASCOPE_API_KEY, protected API endpoints return 503 instead of being open.
SCARASCOPE_REQUIRE_AUTH=false
SCARASCOPE_REQUESTS_PER_MINUTE=60

# Optional local-only semantic search. Directory must exist on the application host.
# Never point this at a remote model ID; no model will be auto-downloaded.
SCARASCOPE_EMBEDDING_MODEL_PATH=
