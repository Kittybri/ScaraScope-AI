# The deploy script generates a private token on the VM. Never commit .env.
SCARASCOPE_API_KEY=

# Live SEC lookups require an application name and your real contact email.
# Leave blank to start with the fictional DEMO only.
SEC_USER_AGENT=

# Optional cloud inference. Leave blank for deterministic financial research.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
SCARASCOPE_REQUESTS_PER_MINUTE=60

# Optional: set this on the VM before running deploy.sh --discord.
# Enable Message Content Intent for your bot in the Discord Developer Portal.
DISCORD_BOT_TOKEN=
